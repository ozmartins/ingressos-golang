{
  "realm": "cinema",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "clients": [
    {
      "clientId": "cinema-app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocolMappers": [
        {
          "name": "aud-cinema-app",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "cinema-app",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "cinema-m2m",
      "enabled": true,
      "publicClient": false,
      "secret": "${CINEMA_M2M_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "webOrigins": [
        "*"
      ],
      "protocolMappers": [
        {
          "name": "aud-cinema-app",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "cinema-app",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "estoque-svc",
      "enabled": true,
      "publicClient": false,
      "secret": "${ESTOQUE_SVC_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "aud-cinema-app",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "cinema-app",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "portaria-svc",
      "enabled": true,
      "publicClient": false,
      "secret": "${PORTARIA_SVC_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "aud-cinema-app",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "cinema-app",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "ufsc",
      "enabled": true,
      "emailVerified": true,
      "email": "ufsc@example.com",
      "firstName": "UFSC",
      "lastName": "Usuario",
      "credentials": [
        {
          "type": "password",
          "value": "${UFSC_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-cinema",
        "catalogo-admin"
      ]
    },
    {
      "username": "service-account-cinema-m2m",
      "serviceAccountClientId": "cinema-m2m",
      "enabled": true,
      "realmRoles": [
        "catalogo-admin"
      ]
    },
    {
      "username": "service-account-estoque-svc",
      "serviceAccountClientId": "estoque-svc",
      "enabled": true,
      "realmRoles": [
        "catalogo-leitura-sessao"
      ]
    },
    {
      "username": "service-account-portaria-svc",
      "serviceAccountClientId": "portaria-svc",
      "enabled": true,
      "realmRoles": [
        "portaria-validar"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "cliente",
        "description": "Pessoa usuária: reserva, paga e vê os próprios ingressos"
      },
      {
        "name": "catalogo-admin",
        "description": "Escreve no catálogo (cinemas, salas, filmes, sessões)"
      },
      {
        "name": "catalogo-leitura-sessao",
        "description": "Consulta sessão por gRPC (uso do serviço de estoque)"
      },
      {
        "name": "portaria-validar",
        "description": "Dispositivo de portaria: dá baixa em ingresso (POST /ingressos/validar)"
      }
    ]
  },
  "defaultRoles": [
    "cliente"
  ]
}
