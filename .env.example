# Copie para .env (cp .env.example .env) e troque cada valor "troque-...".
# O .env NÃO é versionado. O docker-compose.yml se recusa a subir se faltar
# alguma variável marcada como obrigatória.
#
# Observação: as senhas do Postgres só valem na criação do volume. Se o volume
# `postgres-dados` já existe, rode `docker compose down -v` ou altere as senhas
# dos papéis à mão.

# --- PostgreSQL (superusuário e um papel por serviço) ---
POSTGRES_PASSWORD=troque-postgres
CATALOGO_DB_PASSWORD=troque-catalogo-db
ESTOQUE_DB_PASSWORD=troque-estoque-db
NOTIFICACAO_DB_PASSWORD=troque-notificacao-db
PAGAMENTO_DB_PASSWORD=troque-pagamento-db

# --- RabbitMQ (use só caracteres seguros em URL: as credenciais entram em amqp://usuario:senha@host) ---
RABBITMQ_USER=cinema
RABBITMQ_PASSWORD=troque-rabbitmq

# --- Keycloak ---
# Senha do console de administração (usuário "admin").
KEYCLOAK_ADMIN_PASSWORD=troque-keycloak-admin
# Segredo do client confidencial cinema-m2m (máquina a máquina), importado no realm.
CINEMA_M2M_SECRET=troque-segredo-m2m
# Segredo do client estoque-svc: identidade do estoque ao chamar o catálogo por gRPC.
ESTOQUE_SVC_SECRET=troque-segredo-estoque-svc
# Senha do usuário de teste "ufsc" do realm.
UFSC_USER_PASSWORD=troque-senha-usuario-ufsc

# --- Notificação ---
# Segredo do client portaria-svc: identidade do dispositivo da portaria (client
# credentials; o dispositivo troca por um token curto com o papel portaria-validar).
PORTARIA_SVC_SECRET=troque-segredo-portaria-svc
# Segredo HMAC que assina os códigos QR dos ingressos.
INGRESSO_QR_SEGREDO=troque-segredo-do-qr

# --- Opcional: portas expostas no host (valores padrão abaixo) ---
# PORTA_POSTGRES=5434
# PORTA_REDIS=6379
# PORTA_RABBITMQ=5672
# PORTA_RABBITMQ_PAINEL=15672
# PORTA_KEYCLOAK=8081

# --- Opcional: rate limiting (estoque: por usuário em POST /bloqueios, padrão 5/10;
#     pagamento: por usuário em POST /pagamentos/reserva/{id}, padrão 5/10;
#     notificacao: por IP em POST /ingressos/validar, padrão 5/20;
#     catalogo: por IP em /api/*, padrão 50/100 — variáveis lidas por serviço) ---
# RATE_LIMIT_RPS=5
# RATE_LIMIT_BURST=10
