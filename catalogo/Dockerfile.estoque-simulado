FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/estoque-simulado ./cmd/estoque-simulado

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/estoque-simulado /estoque-simulado
USER nonroot:nonroot
EXPOSE 50051
ENTRYPOINT ["/estoque-simulado"]
